# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=sosguepes
DB_SSLMODE=disable

# Mailgun
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_API_KEY=your-mailgun-private-api-key
MAILGUN_REGION=us   # or "eu" if your Mailgun account is on the EU region

# Sender address (must match a verified Mailgun domain)
MAIL_FROM=SOS Guêpes <noreply@mg.yourdomain.com>

# Path to the file listing one recipient email address per line (default: recipients.txt)
RECIPIENTS_FILE=recipients.txt
